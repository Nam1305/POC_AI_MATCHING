# ============================================================
# AI Service Configuration
# Copy this file to `.env` and fill in your API keys.
# ============================================================

# --- LLM Provider (one of: anthropic | groq | gemini | ollama) ---
LLM_PROVIDER=gemini

# Gemini (Google) — recommended
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (local self-hosted)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq (free, dev/fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Embedding Provider (one of: openai | sentence_transformer | gemini | ollama) ---
EMBED_PROVIDER=gemini

# Gemini Embedding (3072-dim) — recommended
GEMINI_EMBED_MODEL=gemini-embedding-001

# OpenAI (1536-dim)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# SentenceTransformer (free local, 384-dim)
ST_EMBED_MODEL=all-MiniLM-L6-v2

# Ollama Embed (local)
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# --- Scoring (Cosine Normalization) ---
# gemini-embedding-001 range for CV/JD pairs is ~0.55–0.90
COSINE_MIN=0.55
COSINE_MAX=0.90

# --- Default Scoring Weights (sum must = 1.0) ---
DEFAULT_WEIGHT_SEMANTIC=0.30
DEFAULT_WEIGHT_SKILLS=0.35
DEFAULT_WEIGHT_EXPERIENCE=0.20
DEFAULT_WEIGHT_EDUCATION=0.10
DEFAULT_WEIGHT_KEYWORDS=0.05

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
