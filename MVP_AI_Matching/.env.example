# ============================================================
# AI Service Configuration
# Copy this file to `.env` and fill in your API keys.
# ============================================================

# --- LLM Provider (one of: anthropic | groq) ---
LLM_PROVIDER=groq

# Anthropic Claude (production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq (free, dev/fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Embedding (Gemini only, gemini-embedding-001, 3072-dim) ---
# Shares GEMINI_API_KEY with LLM_PROVIDER=gemini above.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Scoring (Cosine Normalization) ---
# No stretch — raw cosine similarity used as-is. Recalibrate once real
# CV/JD embedding data is available under the new (skills-stripped) D1 text.
COSINE_MIN=0.00
COSINE_MAX=1.00

# --- Default Scoring Weights (sum must = 1.0) ---
DEFAULT_WEIGHT_SEMANTIC=0.30
DEFAULT_WEIGHT_SKILLS=0.35
DEFAULT_WEIGHT_EXPERIENCE=0.20
DEFAULT_WEIGHT_EDUCATION=0.10
DEFAULT_WEIGHT_LOCATION=0.05

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
